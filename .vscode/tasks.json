
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Aplikasi Futsal",
            "type": "shell",
            "command": "g++",
            "args": [
                "-Wall",
                "-Wextra",
                "-g3",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/lapangan.cpp",
                "${workspaceFolder}/perlengkapan.cpp",
                "${workspaceFolder}/booking.cpp",
                "-o",
                "${workspaceFolder}/output/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}